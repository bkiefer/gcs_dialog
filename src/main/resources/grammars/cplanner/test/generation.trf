//remember_name, greet_back
raw:ReturnGreeting ^ Greet
    {
    ^ ! <anrede> ^ ! <name>
    ->
    # =  :canned ^ <string>"Hallo, schön Sie zu sehen. Ich bin Rolli.".

    ^ ! <anrede> ^ <name>#n
    ->
    # = :canned ^ <string>concatenate("Gut Sie wiederzusehen ", #n).

    ^ <anrede>#a ^ <name>#n
    ->
    # = :canned ^ <string>concatenate("Gut Sie wiederzusehen, ",#a, " ", #n).
    }

