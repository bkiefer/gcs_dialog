# =  :canned ^ <string>"Hier halb rechts abbiegen".

raw:Inform ^ ContinueRoute ^ <info>(#i: ^ !<dir1>)
{
^ <andthen>HR -> #i ^ <dir1>"halb rechts".
^ <andthen>HL -> #i ^ <dir1>"halb links".
^ <andthen>L -> #i ^ <dir1>"links".
^ <andthen>R -> #i ^ <dir1>"rechts".
^ <andthen>RL -> #i ^ <dir1>"scharf links".
^ <andthen>RR -> #i ^ <dir1>"scharf rechts".
^ !<andthen> -> #i ^ <dir1>"".
}

raw:Inform ^ ContinueRoute ^ <info>(#i: ^ !<dir>)
{
^ <how>HR -> #i ^ <dir>"halb rechts".
^ <how>HL -> #i ^ <dir>"halb links".
^ <how>L -> #i ^ <dir>"links".
^ <how>R -> #i ^ <dir>"rechts".
^ <how>RL -> #i ^ <dir>"scharf links".
^ <how>RR -> #i ^ <dir>"scharf rechts".
^ !<how> -> #i ^ <dir>"".
}




