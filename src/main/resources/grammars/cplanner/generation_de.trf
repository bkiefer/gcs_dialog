  ^ <body_part>"hand"
  ->
  # = :canned ^ <string>"Bitte versuchen Sie, Ihre Hand zu bewegen." .

  ^ <body_part>"arm"
  ->
  # = :canned ^ <string>"Bitte versuchen Sie, Ihren Arm zu bewegen." .
  
  ^ <body_part>"leg"
  ->
  # = :canned ^ <string>"Bitte versuchen Sie, Ihr Bein zu bewegen." .
  
  
 raw:Inform ^ MotionExecuted
    ->
    # = :canned ^ <string>"Das haben Sie sehr gut gemacht, vielen Dank." .

