raw:Inform ^ clenchHand
    ->
    # = :canned ^ <string>"Bitte versuchen Sie, Ihre Hand zur Faust zu ballen." .

//open fist
raw:Inform ^ openHand
    ->
    # = :canned ^ <string>"Sehr gut. Bitte öffnen Sie die Faust wieder." .

