    ->
    # = :canned ^ <string>"Können Sie mich hören?" .

raw:YNQuestion ^ checkResponseAgain
    ->
    # = :canned ^ <string>"Wenn Sie mich hören können, sagen Sie bitte etwas." .

raw:Question ^ Name
    ->
    # = :canned ^ <string>random("Wie heißen Sie?",
                                    "Sagen Sie mir bitte, wie Sie heißen.") .
                                    
