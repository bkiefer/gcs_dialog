/******************************************************************************/
//phase1: ask to open eyes
raw:Inform ^ eyes
    ->
    # = :canned ^ <string>random("Können Sie Ihre Augen öffnen?",
                                    "Öffnen Sie bitte Ihre Augen.",
                                    "Wenn Sie mich hören können, öffnen Sie bitte Ihre Augen.") .

/******************************************************************************/
//clench fist
