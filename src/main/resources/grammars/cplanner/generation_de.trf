// Rolli.rudi and other general utterances

raw:Request ^ Inform ^<what>Done
->
# = :canned ^ <string>random("Sagen Sie mir bitte Bescheid, wenn Sie fertig sind ." ,
"Lasses sie mich wissen, wenn sie fertig sind." ,
"Sag Bescheid, wenn du fertig bist."
).

raw:Inform ^ Done
->
# = :canned ^ <string>random("So, ich bin fertig .", "Das wäre erledigt .", "Habe fertig" ).

raw: Request ^ Follow
->
# = :canned ^ <string>random("Folgen Sie mir bitte .", "Mir nach! " ).

//ask_for_name:
raw:WHQuestion ^ Name
->
# =  :canned ^ <string>random("Wie heißen Sie ?", 
                                    "Wie ist ihr Name ?", 
                                    "Wollen Sie sich mir vorstellen ?",
                                    "Darf ich Ihren Namen erfahren ?").
/******************************************************************************/
//Thanking
raw:Thanking ^ Generell
->
# =  :canned ^ <string>random("Danke für Ihre zusammenarbeit .",
                                    "Ich bedanke mich vielmals .",
                                    "Dankeschön .",
                                    "Vielen Dank .").
/******************************************************************************/
//Confirm understanding
raw:Confirm ^ Understood
    ->
    # = :canned ^ <string>random("Verstanden .", "In Ordnung .", "Ja , ich habe verstanden .").

/******************************************************************************/
raw:Inform ^ Farewell
{
 ^ !<greet>
    {
        ^ !<timeOfDay>
        ->
        # ^ <greet>random("Einen schoenen Tag noch .", "Bis dann .").// default case

        ^ <timeOfDay>morning
        ->
        # ^ <greet>random("Einen schoenen Resttag noch  .", "Einen guten Morgen noch ." ).

        ^ <timeOfDay>day
        ->
        # ^ <greet>random("Guten Tag .", "Einen wunderschoenen guten Tag noch.").//# = :canned ^ <string>"Guten Tag".

        ^ <timeOfDay>(evening|night)
        ->
        # ^ <greet>random("Eine gute Nacht wuensche ich .", "Einen schoenen Abend noch .").//#i ^ <greet>"Guten Abend".
    }

^ <greet>#gr
    {
        ^ !<lastName>
        ->
        # = :canned ^ <string>random(#gr, "Bis dann", "Auf wiedersehen .").

        ^ <lastName>#n ^ <anrede>#a
        ->
        # = :canned ^ <string>concatenate(random(#gr, "Hallo"), ", ", #a, " ", #n ," .").
    }
}


raw:ReturnGreeting ^ Greet
{
 ^ !<greet>
    {
        ^ !<timeOfDay>
        ->
        # ^ <greet>random("Guten Tag . ", "Einen wunderschoenen guten Tag .").// default case

        ^ <timeOfDay>morning
        ->
        # ^ <greet>random("Guten Morgen .", "Einen guten Morgen ." , "Einen wunderschoenen guten Morgen .", "Moin moin .").

        ^ <timeOfDay>day
        ->
        # ^ <greet>random("Guten Tag .", "Einen wunderschoenen guten Tag .", "Mahlzeit.").//# = :canned ^ <string>"Guten Tag".

        ^ <timeOfDay>(evening|night)
        ->
        # ^ <greet>random("Guten Abend .", "Einen guten Abend wuensche ich .", "N'abend .").//#i ^ <greet>"Guten Abend".
    }

^ <greet>#gr
    {
        ^ !<lastName>
        ->
        # = :canned ^ <string>random(#gr, "Hallo", "Hi").

        ^ <lastName>#n ^ <anrede>#a
        ->
        # = :canned ^ <string>concatenate(random(#gr, "Hallo"), ", ", #a, " ", #n ," .").
    }
}


