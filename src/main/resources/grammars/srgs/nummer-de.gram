#ABNF 1.0 UTF-8;

language de-DE;
root $number;
mode voice;
tag-format "semantics/1.0";

$number = $cardinal | $ordinal { out = "$$1"; };

$cardinal = "$$(ein|eins|eine|einer|zwei|drei|vier|fünf|sechs|sieben|acht|neun)"
          | "$$(zehn|elf|zwölf|(drei|vier|fünf|sech|sieb|acht|neun)zehn)"
          | "$$((ein|zwei|drei|vier|fünf|sechs|sieben|acht|neun)und)?(dreißig|(zwan|vier|fünf|sech|sieb|acht|neun)zig)" { out = "$$1"; };

$ordinal = "$$((ers|zwei|drit|vier|fünf|sechs|sieb|ach|neun)te[rn]?)|((zehn|elf|zwölf|((drei|vier|fünf|sechs|sieb|acht|neun)zehn))te[rn]?)|(((ein|zwei|drei|vier|fünf|sechs|sieben|acht|neun)und)?(dreißig|(zwan|vier|fünf|sech|sieb|acht|neun)zig)ste[rn]?)" { out = "$$1"; };
