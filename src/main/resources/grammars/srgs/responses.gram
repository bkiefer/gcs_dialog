#ABNF 1.0 UTF-8;

language de_DE;
root $root;
mode voice;
tag-format "semantics/1.0";

/* $day = "$$[0-9]" *; */

$junk = $GARBAGE<0-2>;

$day_of_week = $<date.gram#day_of_week>;
$day_of_month = $<date.gram#day_of_month>;
$month = $<date.gram#month>;

$ithink = ([ich] (denke|glaube|meine)) | (denke|glaube|meine) ich;

$dow_response = $junk [$ithink] [heute ist | es ist] ([$ithink] $day_of_week {out.what="$$1"; }
			| $day_of_week {out.what="$$1"; } $ithink)
         { out.da="Inform" ; out.prop="DayOfWeek";} $junk;

$month_opt_day = [[der] $day_of_month {out.day="$$1";}] $month {out.what = "$$1";}|
            $month {out.what = "$$1";} [der] $day_of_month {out.day="$$1";};

$month_response = $junk [heute ist | es ist | momentan ist]([$ithink] $month_opt_day { out = $%1 }
                | $month_opt_day { out = $%1 } $ithink
                ) { out.da = "Inform"; out.prop = "Month"; } $junk;

$ambig = $junk $<general.gram#confirm> $dow_response { out.da="Inform"; out.prop="DayOfWeek"; out = $%1; } |
		 $junk $<general.gram#confirm> $month_response { out.da="Inform"; out.prop="Month"; out = $%1; };

public $root = ($dow_response | $month_response | $<general.gram> | $ambig | $<general.gram#confirm>)
       { out = $%1; };
