//phase1: ask to open eyes
raw:Instruct ^ OpenEyes ^ (! <tryNo> | <tryNo> 1)
    ->
    # = :canned ^ <string>"Öffnen Sie bitte die Augen, wenn Sie mich hören können.".

raw:Instruct ^ OpenEyes ^ <tryNo> 2
    ->
    # = :canned ^ <string>"Können Sie bitte ihre Augen öffnen?".


raw:Inform ^ Thanks
    ->
    # = :canned ^ <string>"Vielen Dank. Die Rettungskräfte wurden über Ihren Zustand informiert und werden
    in Kürze hier eintreffen.".
