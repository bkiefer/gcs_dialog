//motor skills

//@Christian: Schauen wir nur, ob die Hand sich bewegt oder auch explizit, ob sie geschlossen bzw. geoeffnet wird?
// Bei letzterem muesste ich naemlich zwischen isHandOpen fuer rechte und linke Hand unterscheiden, das geht momentan noch nicht soweit ich das sehe.

phase_three:
if(state == "gcs_phase3"){
    System.err.println("Starting phase 3");
    user.gcs_phase3 = 1;
    emitDA(#Inform(Phase3));
    state="wait";
    //move hand
    if (!(user.hasMovedLeftHand == -1 && user.hasMovedRightHand == -1 )){   //checke ob lesbare Hand vorhanden
        //Checke ob beide sichtbar 
        if (!(user.hasMovedLeftHand == -1) && !(user.hasMovedRightHand == -1)){
            if (user.leftHandConfidence > user.rightHandConfidence){
                emitDA(#Inform(moveLeftHand));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_left_hand";
                }
            } else {
                emitDA(#Inform(moveRightHand));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_right_hand";
                }
            }
        } else {    // nur eine Hand sichtbar
            if (user.hasMovedLeftHand == -1){   //linke Hand nicht sichtbar
                emitDA(#Inform(moveRightHand));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_right_hand";
                }
            } 
            //TODO else statt zweites if
            if (user.hasMovedRightHand == -1){  //rechte Hand nicht sichtbar
                emitDA(#Inform(moveLeftHand));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_left_hand";
                }
            }
        }    
    }else{ 
        //Kein Reading fuer die Haende: weiter mit Armen
        //state = "wait";
        //timeout("wait", 5000){
        state = "wait_check_arm";
        //}
    }
}


phase_three_move_right_hand:
if (state == "wait_move_right_hand"){
    if (user.hasMovedRightHand == 1){
       user.gcs_phase3 = user.gcs_phase3 + 1;
    }
    //arm movement
    state="wait";
    timeout("wait", 5000){
        state = "wait_check_arm";
    }
}

phase_three_move_left_hand:
if (state == "wait_move_left_hand"){
    if (user.hasMovedLeftHand == 1){
       user.gcs_phase3 = user.gcs_phase3 + 1;
    }
    //arm movement
    state="wait";
    timeout("wait", 5000){
        state = "wait_check_arm";
    }
}


