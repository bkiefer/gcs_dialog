//**********************************************//
// Arme

phase_three_check_arm:
if(state == "wait_check_arm"){
    if (!(user.hasMovedLeftArm == -1 && user.hasMovedRightArm == -1 )){   //checke ob lesbarer Arm vorhanden
        //Checke ob beide sichtbar 
        if (!(user.hasMovedLeftArm == -1) && !(user.hasMovedRightArm == -1)){
            //checke  Confidence
            if (user.leftArmConfidence > user.rightArmConfidence){
                emitDA(#Inform(moveLeftArm));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_left_arm";
                }
            } else {
                emitDA(#Inform(moveRightArm));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_right_arm";
                }
            } 
        } else {    // nur ein Arm sichtbar
            if (user.hasMovedLeftArm == -1){   //linker Arm nicht sichtbar
                emitDA(#Inform(moveRightArm));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_right_arm";
                }
            } 
            //TODO else statt zweites if
            if (user.hasMovedRightArm == -1){  //rechter Arm nicht sichtbar
                emitDA(#Inform(moveLeftArm));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_left_arm";
                }
            }
        }    
    } else { 
        //Kein Reading fuer die Arme: weiter mit Beinen
        state = "wait";
        timeout("wait", 5000){
            state = "wait_check_leg";
        }
    }
}

phase_three_move_right_arm:
if(state == "wait_move_right_arm"){
    if (user.hasMovedRightArm == 1){
        user.gcs_phase3 = user.gcs_phase3 + 1;
    }
    // TODO nochmal auffordern wenn keine Bewegung?
    state="wait";
    timeout("wait", 5000){
        state = "wait_check_leg";
    }
}

phase_three_move_left_arm:
if(state == "wait_move_left_arm"){
    if (user.hasMovedLeftArm == 1){
        user.gcs_phase3 = user.gcs_phase3 + 1;
    }
    // TODO nochmal auffordern wenn keine Bewegung?
    state="wait";
    timeout("wait", 5000){
        state = "wait_check_leg";
    }
}


//**********************************************//
// Beine

phase_three_check_leg:
if(state == "wait_check_leg"){
    if (!(user.hasMovedLeftLeg == -1 && user.hasMovedRightLeg == -1 )){   //checke ob lesbares Bein vorhanden
        //Checke ob beide sichtbar 
        if (!(user.hasMovedLeftLeg == -1) && !(user.hasMovedRightLeg == -1)){
            //checke  Confidence
            if (user.leftLegConfidence > user.rightLegConfidence){
                emitDA(#Inform(moveLeftLeg));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_left_leg";
                }
            } else {
                emitDA(#Inform(moveRightLeg));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_right_leg";
                }
            } 
        } else {    // nur ein Bein sichtbar
            if (user.hasMovedLeftLeg == -1){   //linkes Bein nicht sichtbar
                emitDA(#Inform(moveRightLeg));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_right_leg";
                }
            } 
            //TODO else statt zweites if
            if (user.hasMovedRightLeg == -1){  //rechtes Bein nicht sichtbar
                emitDA(#Inform(moveLeftLeg));
                state = "wait";
                timeout("wait", 5000){
                    state = "wait_move_left_leg";
                }
            }
        }    
    } else { 
        //Kein Reading fuer die Beine: weiter zur naechsten Phase
        state = "gcs_done";
    }
}

phase_three_move_right_leg:
if(state == "wait_move_right_leg"){
    if (user.hasMovedRightLeg == 1){
        user.gcs_phase3 = user.gcs_phase3 + 1;
    }
    // TODO nochmal auffordern wenn keine Bewegung?
    emitDA(#Inform(Thanks));
    state = "gcs_done";
}

phase_three_move_left_leg:
if(state == "wait_move_left_leg"){
    if (user.hasMovedLeftLeg == 1){
        user.gcs_phase3 = user.gcs_phase3 + 1;
    }
    // TODO nochmal auffordern wenn keine Bewegung?
    emitDA(#Inform(Thanks));
    state = "gcs_done";
}





