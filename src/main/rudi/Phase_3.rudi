//motor skills

phase_three:
if(state == "gcs_phase3"){
    System.err.println("Starting phase 3");
    user.gcs_phase3 = 1;
    state="wait";
    //clench and open hand
    //TODO: sollten wir vorher prüfen, ob die Hand evtl bereits geballt ist?
    emitDA(#Inform(clenchHand));
    timeout("wait", 5000){
      state = "wait_clench_hand";
    }
}

phase_three_clench_hand:
if (state == "wait_clench_hand"){
    if (user.isHandOpen == false){
       user.gcs_phase3 = user.gcs_phase3 + 1;
       emitDA(#Inform(openHand));
       state="wait";
       timeout("wait", 5000){
          state = "wait_open_hand";
       }
    } else {
    // TODO @Katharina: was tun wir, wenn der Patient keine Faust machen konnte? Direkt zu den Armen oder noch einmal auffordern? Deine Entscheidung ;-)
    // @Christian: Noch einmal auffordern fände ich prinzipiell ganz gut, aber müssten wir das dann nicht bei jedem Schritt so handhaben? Wäre das zeitlich noch im Rahmen oder würde Phase3 zu sehr ziehen?
    state = "gcs_done"; // TODO: @Katharina: gcs done ist hier nur, damit die Regel terminieren kann.
    }
}


phase_three_open_hand:
if (state == "wait_open_hand"){
    if (user.isHandOpen == true){
       user.gcs_phase3 = user.gcs_phase3 + 1;
    }
    //arm movement
    emitDA(#Inform(moveArm));
    state="wait";
    timeout("wait", 5000){
        state = "wait_move_arm";
    }
}

phase_three_move_arm:
if(state == "wait_move_arm"){
    if ((user.hasMovedLeftArm == 1) || (user.hasMovedRightArm == 1)){
        user.gcs_phase3 = user.gcs_phase3 + 1;
    }
    emitDA(#Inform(moveLeg));
    state="wait";
    timeout("wait", 5000){
        state = "wait_move_leg";
    }
}

phase_three_move_leg:
if (state == "wait_move_leg"){
    if ( (user.hasMovedLeftLeg == 1) || (user.hasMovedRightLeg == 1)){
        emitDA(#Inform(Thanks));
        user.gcs_phase3 = user.gcs_phase3 + 1;
        state = "gcs_done";
    } else {
        emitDA(#Inform(Thanks));
        state = "gcs_done";
    }
}

