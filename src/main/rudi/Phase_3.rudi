phase_three:
if(state == "gcs_phase3"){
    System.err.println("Starting phase 3");
    state = "gcs_done";
    dialogAgent.gcs_phase3 = 1;
    //clench and open hand
    //TODO: Welche Hand?
    emitDA(#Inform(clenchHand));
    timeout("wait", 5000){
      if (user.isHandOpen == false){
        dialogAgent.gcs_phase3 = dialogAgent.gcs_phase3 + 1;
        emitDA(#Inform(openHand));
        timeout("wait", 5000){
          if (user.isHandOpen == true){
            dialogAgent.gcs_phase3 = dialogAgent.gcs_phase3 + 1;
          }
        }
      }
    }
    //arm movement
    emitDA(#Inform(moveArm));
    timeout("wait", 5000){
      if ((user.hasMovedLeftArm || user.hasMovedRightArm) == true){
        dialogAgent.gcs_phase3 = dialogAgent.gcs_phase3 + 1;
      }
    } 
}

