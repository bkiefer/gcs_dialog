/** Motion Phase */
// Incoming: --> { "cmd": "motion_request", "arg0": "<motion>" }
// Outgoing: <-- { "status": "motion_requested", "arg0": "<motion>" }

// boolean to check if introduction to motion phase was already given or not
phase_three:
if (checkCmd("motion_request")){
  if (! saidInSession(#Inform(Phase3))) {
    // Intro Dialog Phase 3
    emitDA(#Inform(Phase3));
    lastDAprocessed();
    intro_motion = true;
  }
  String[] limb_side = splitLimb(in_msg.arg0);
  // ask motion
  da = #Instruct(Motion, body_part={limb_side[0]});
  if (limb_side.length > 1) {
    da.setValue("side", limb_side[1]);
  }
  emitDA(da);

  // TODO
  // session.state = "motion_requested";
  // send signal motion_requested
  // out_msg.clear();
  sendSignal("motion_requested", in_msg.arg0);
}

// motion executed:
// --> { "cmd": "motion_executed", "arg0": "<motion>" }
motion_executed:
if (checkCmd("motion_executed")){
  emitDA(#Inform(MotionExecuted));
}
