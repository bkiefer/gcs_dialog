import java.util.Calendar;
import de.dfki.vondabase.data.Command;
import de.dfki.vondabase.data.Signal;

include NLU;

BaseCommunicationHub getHub() {
  return isa(BaseCommunicationHub, _hub);
}

// incoming MQTT messages are received using a callback
Command in_msg = getCommand();
if (in_msg) {
  timeout("stale_signal", 1500) {
    logger.warn("Signal not processed in time: {}", in_msg);
    removeLastCommand();
  }
}

GcsQuestion currQuestion;
Session session;

void sendSignal(String state, String arg) {
  if (user) {
    getHub().sendSignal(new Signal(user.id, state, arg));
  }
}

void sendSignal(String state) {
  sendSignal(state, null);
}

boolean checkCmd(String cmd) {
  if (in_msg && in_msg.cmd == cmd) {
    removeLastCommand();
    return true;
  }
  return false;
}


// accumulate signals for articulate speech and mouth movements
// amount of speech that should at least be articulate
ARTICULATE_THRESHOLD = 0.7;
// how many mouth movements should have been detected to acknowledge activity?
// this is depending on the rate of the incoming signal and total time
NO_MOUTH_THRESHOLD = 0.3;
long time_passed; // if < 0, signals we're not waiting for speech signals
int total_articulate;
int positive_articulate;
int total_mouth_moves;

void start_speech_check() {
  time_passed = now();
  total_articulate = positive_articulate = total_mouth_moves = 0;
}

// Returns -1 if no activity at all, 0 if unarticulated speech, 1 articulated,
// but obviously not picked up by ASR
int end_speech_check() {
  passed = 1.0 * (now() - time_passed);
  time_passed = -1;
  if ((passed / total_mouth_moves) < NO_MOUTH_THRESHOLD)
    return -1; // no activity
  return (1.0 * positive_articulate / total_articulate
          > ARTICULATE_THRESHOLD) ? 1 : 0;
}

// treat the initial part: either session, or start_gcs required

if (! session) {
  no_session_check_start:
  if (in_msg) {
    removeLastCommand(); // in any of the following cases
  session_starts:
    if (in_msg.cmd == "start_gcs") {
      logger.info("GCS service started");
      session = new Session; // new session
      session.state = "started";
      user = getUser(in_msg.user_id);
      if (! user) {
        user = new User;
        user.id = in_msg.user_id;
      }
      user.sessions += session;
      //<-- { "status": "ready" }
      sendSignal("ready");
    } else {
      logger.warn("Invalid message outside session: {}", in_msg.cmd);
      cancel;
    }
  } else {
    cancel;
  }
}

// from here, we have a running session

if (in_msg && in_msg.user_id != user.id) {
  logger.warn("User id changed during session from {} to {}!", user.id,
              in_msg.user_id);
}


//include test;
include accumulator;
include Phase_1;
include Phase_2;
include Phase_3;

/** finalizing */
// --> { "cmd": "finalize" }
// <-- { "status": "finalizing", "state": "started"/"stopped" }
logger.info("cmd: {}", in_msg);

finalizing:
if (checkCmd("finalize")){
  sendSignal("finalizing", "started");
  emitDA(#Inform(Thanks));
  sendSignal("finalizing", "stopped");
}

// --> { "cmd": "end_gcs", "id": "<user_id>" }
gcs_end:
if (checkCmd("end_gcs")){
  // Close session, current_session = null, user = null
  session = null;
  user = null;
  reset();
}

exit:
if (checkCmd("exit")){
  // Close session, current_session = null, user = null
  session = null;
  user = null;
  getHub().shutdown();
}
