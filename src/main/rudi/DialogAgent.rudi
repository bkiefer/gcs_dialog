greet_back: //TODO: add time when greeting back
if (lastDA() >= #InitialGreeting(Greet)) {
  System.err.println("greet back");
  propose("greet back") {
    emitDA(#ReturnGreeting(Greet, timeOfDay={getDayTime().toString()}));
  }
  lastDAprocessed();
  timeout("clear", 30000){
     // do something here
  }
}

gcs:
if (state == "gcs_init"){
    System.err.println("GCS service started");
    state = "gcs_greet";
    newData();
}
