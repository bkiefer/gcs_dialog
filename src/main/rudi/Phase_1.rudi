
//aufraeumen, elses statt returns?
//Check eyes opening

//TODO: Repeat DRZGreet if eyes closed for too long
phase_one:
if(state == "gcs_phase1"){
    if (user.areEyesOpen == false){
         emitDA(#Inform(OpenEyes));
         state="wait";
         timeout("wait", 15000){
             state = "p1_3";
         }
    } else {
     emitDA(#Inform(Fragen));
     dialogAgent.gcs_phase1 = 4;
     state = "gcs_phase2";
    }
}

phase_one_wait_3:
if (state == "p1_3"){
    if (user.areEyesOpen == false){
             emitDA(#Inform(HeyOpenEyes));
             state="wait";
             timeout("wait", 15000){
                 state = "p1_1";
             }
        } else {
         emitDA(#Inform(Fragen));
         dialogAgent.gcs_phase1 = 3;
         state = "gcs_phase2";
        }
}

phase_one_wait_1:
if (state == "p1_1"){
    if (user.areEyesOpen == false){
            dialogAgent.gcs_phase1 = 1;
            state = "gcs_done";
        } else {
         emitDA(#Inform(Fragen));
         dialogAgent.gcs_phase1 = 2;
         state = "gcs_phase2";
        }
}