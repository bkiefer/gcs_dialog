//Check eyes opening

//TODO: Repeat DRZGreet if eyes closed for too long
phase_one:
if(state == "gcs_phase1"){
    System.err.println("Starting phase 1");
    state = "gcs_phase2";
    if (user.areEyesOpen == true){
           dialogAgent.gcs_phase1 = 4;
           return 0;
    }
    emitDA(#Inform(eyes));
    state="wait";
    timeout("wait", 10000){
       if (user.areEyesOpen == true){
           dialogAgent.gcs_phase1 = 3;
           return;
       }
       emitDA(#Inform(DRZGreet));
       emitDA(#Inform(eyes));
       if (user.areEyesOpen == true){
           dialogAgent.gcs_phase1 = 2;
           return;
       }
       dialogAgent.gcs_phase1 = 1;
    }
}