/*@
import de.dfki.vondabase.utils.Triple;
import de.dfki.vondabase.utils.Quartet;
import java.util.Calendar;
@*/

// TODO emitDA(#Inform(Fixpunkt)) nach checkResponse?
// TODO: Fragenliste randomisiert erstellen? (mindestanzahl Orientierungsfragen?) --> Anzahl Orientierungsfragen uebernehmen
// TODO: No_intent Fälle abfangen

/** GCS verbale Phase:
    konversationsfähig + orientiert: 5 Punkte
    konversationsfähig + desorientiert: 4 Punkte
    einzelne, unzusammenhängende Worte: 3 Punkte
    sinnlose Laute: 2 Punkte (können wir derzeit nicht unterscheiden von fehlendem Input)
    keine verbale Antwort: 1 Punkte
**/

/** Ablauf Phase 2:
tmp_score = 1
sum_orientiert = 0
num_orientiert = 0
if (patient nicht ansprechbar):         (max 2x)
    state == phase 5 (done)
else:
    for question in [Name, Alter, Birthdate, Adresse, location, Wochentag, Datum....]:
        ask question:
            if answer is not a word:     (antwortet nur in Lauten)
                tmp_score += 1
                continue
            if answer in scope:            (konversationsfähig,)
                tmp_score += 3
                if question in [location, Wochentag, Datum]:
                    if answer correct:
                        sum_orientiert += 1
                        num_orientiert += 1
            else:                       (antwortet in unzusammenhängenden Wörtern)
                tmp_score += 2
    user.gcs_phase2 = tmp_score / #questions
    if sum_orientiert >= num_orientiert/2:   (wenn Hälfte der Orientierungsfragen korrekt --> orientiert)
        user.gcs_phase2 += 1
    ask pain:
        user.pain = answer
    state == phase 3
**/
/***************************************/

// array of weekdays for orientation question check
List<String> weekdays = {
  "Sonntag", "Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag"
};

// array of locations for orientation question check (nur Demo zwecke)
List<String> locations = { "Hauptstraße", "Saarbrücken", "Mannheim", "Stuhlsatzenhausweg", "Mainzer Straße" };


/******** Phase 2 Start *********/

phase_two_start:
if(state == "gcs_phase2"){
    user.gcs_phase2 = 1;
    no_reaction = false;
    emitDA(#YNQuestion(checkResponse));
    System.err.println("LA1: " + lastDA());
    state="wait";
    timeout("wait", 10000){
        state = "wait_response";
    }
}


phase_two_wait_response:
if(state == "wait_response"){
    System.err.println("LA2: " + lastDA());
    // Check if patient responds(2x)
    if (lastDA() >= #Bottom(Bottom)){       // if no verbal reaction
        if (no_reaction == true){       // patient did not respond 1x
            // skip Phase 3 --> Phase 5
            state = "gcs_done";
        } else {        // repeat checkResponse
            no_reaction = true;
            emitDA(#YNQuestion(checkResponseAgain));
            state="wait";
            timeout("wait", 5000){
                state = "wait_response";
            }
        }
    } else {
        user.gcs_phase2 += 1;
        // fill question list
        // save questions as Quartet: (DA, intent, concept, bool (Orientierungsfrage ja/nein?))
        questions = new LinkedList<Quartet<DialogueAct, String, String, Boolean>>();
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askName), "NAME", "Name", false));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askAge), "AGE", "Age", false));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askBirthdate), "Date", "nuance_CALENDARX", false));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askAdress), "Location", "nuance_LOCATION", false));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askLocation), "Location", "nuance_LOCATION", true));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askDay), "Date", "Weekday", true));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askDate), "Date", "nuance_CALENDARX", true));

        sum_phase2 = 0;         // sum of scores of all questions
        sum_orientiert = 0;     // number of correctly answered orientation questions
        num_questions = questions.size();   // number of questions
        System.err.println("Anzahl Fragen: " + num_questions);
        num_orientiert = 3; // number of orientation questions
        state = "wait";
        state = "ask_question";     // start asking questions
    }
}


phase_two_ask_question:
if(state == "ask_question"){
    // check if question list empty (= all questions asked) --> if so: continue with score calculation etc.
    if (questions.isEmpty() == true){
        // proceed with score calculation
        System.err.println("No questions left.");
        state = "calculate_score";
    } else {            // ask first question in list
        emitDA(questions.get(0).getFirst());
        state = "wait";
        timeout("wait", 20000){
            state = "wait_answer";
        }
    }
}


phase_two_wait_answer:
if (state == "wait_answer"){
    // Check quality of answer
    if (!(lastDA() >= #Bottom(Bottom))){    // check if patient answered
        if (lastDA() >= #Disagreement(NotParse)){           // check if answer cannot be interpreted
            sum_phase2 += 1;
            System.err.println("Answer could not be parsed");
        } else {
            // check if answer is in scope
            // get proposition and compare to lastDA
            String tmp = questions.get(0).getSecond();
            if (lastDA().getProposition() == tmp){
                sum_phase2 += 3;
                // TODO
                System.err.println("Answer is in scope: " + tmp);
                // check if orientation question; if yes: answer correct?
                if (questions.get(0).getFourth() == true){
                    //TODO
                    System.err.println("Orientierungsfrage: " + tmp);
                    if (tmp == "Location"){
                        answer = lastDA().nuance_LOCATION;
                        //TODO
                        System.err.println("Answer: " + answer);
                        System.err.println("Loc: " + locations.get(1));
                        // check if answer is in locations list; if yes: +1 to orientation score
                        if (locations.contains(answer)){
                            sum_orientiert += 1;
                        } else {
                            System.err.println("Location not in list");
                        }
                    } else {    // andernfalls: Date
                        Calendar calendar = Calendar.getInstance();
                        // Current day of week
                        if (questions.get(0).getThird() == "Weekday"){
                            answer = lastDA().Weekday;
                            weekday = weekdays.get(calendar.get(Calendar.DAY_OF_WEEK) - 1);
                            // check if answer is correct day; if yes, +1 to orientiert score
                            if (answer == weekday){
                                sum_orientiert += 1;
                            }
                            // safe answer in user
                            user.answersWeekday = answer;
                        }
                        // Current Date
                        if (questions.get(0).getThird() == "nuance_CALENDARX"){
                            answer = lastDA().getValue("nuance_CALENDARX");
                            // TODO check Date format
                            // TODO patient could only name day and month?
                            date = (calendar.get(Calendar.DAY_OF_MONTH)) + "." + (calendar.get(Calendar.MONTH) + 1) + "." + (calendar.get(Calendar.YEAR));
                            // check if answer is correct day; if yes, +1 to orientiert score
                            if (answer == date){
                                sum_orientiert += 1;
                            }
                            // safe answer in user
                            user.answersDate = answer;
                        }
                    }
                }
                // if birtdate question: save answer in user
                // TODO find better way to compare / check for question ( tmp == askBirthdate?)
                if ((questions.get(0).getSecond() == "Date") && (questions.get(0).getThird() == "nuance_CALENDARX") && (questions.get(0).getFourth() == false)){
                    user.answersBirthday = lastDA().getValue("nuance_CALENDARX");
                    // TODO
                    //System.err.println("Birtday saved: " + user.answersBirthday);
                }
            } else {
                // TODO
                System.err.println("Answer not in scope: " + tmp);
                sum_phase2 += 2;
            }
        }
    }
    // remove question from list
    questions.remove(0);
    //TODO
    System.err.println("Question removed, continue with next question");
    state = "wait";
    timeout("wait", 3000){
        state = "ask_question"; //ask next question
    }
}


phase_two_calculate_score:
if(state == "calculate_score"){
    System.err.println("Calculate Score.");
    user.gcs_phase2 = sum_phase2 / num_questions; // TODO aufrunden oder ganzzahlig dividieren?
    // compute score for orientation questions
    if (sum_orientiert >= (num_orientiert/2)){   // wenn ca. Hälfte der Orientierungsfragen korrekt: +1 für orientiert
        user.gcs_phase2 += 1;
    }
    // ask for pain
    emitDA(#Question(askPain));
    state = "wait";
    timeout("wait", 10000){
        state = "wait_pain";
    }
}


phase_two_wait_pain:
if(state == "wait_pain"){
    System.err.println("Get Pain information.");
    // save answer in user
    if (!(lastDA() >= #Bottom(Bottom))){    // prüfe ob Patient antwortet
        if (lastDA() >= #Confirm(Confirm)){
            user.hasPain = true;
        } else {
            user.hasPain = false;   // TODO auch false wenn Reaktion nicht auf Frage passt?
        }
    }
    // TODO prints zum testen
    System.err.println("answersDate: " + user.answersDate);
    System.err.println("answersWeekday: " + user.answersWeekday);
    System.err.println("answersBirthday: " + user.answersBirthday);
    System.err.println("pain: " + user.hasPain);
    // TODO print score
    // weiter Phase 3
    state = "gcs_phase3";
}
