import java.util.Calendar;
import java.util.Random;

/**
TODOs
- save the result of questioning and "artikulierte sprache" into session object
**/

/** GCS verbale Phase:
    konversationsfähig + orientiert: 5 Punkte
    konversationsfähig + desorientiert: 4 Punkte
    einzelne, unzusammenhängende Worte: 3 Punkte
    sinnlose Laute: 2 Punkte (können wir derzeit nicht unterscheiden von fehlendem Input)
    keine verbale Antwort: 1 Punkte
**/

// array of weekdays for orientation question check
List<String> weekdays = {
  "Sonntag", "Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag"
};

// array of months for orientation question check
List<String> months = {
  "Januar", "Februar", "Maerz", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"
};

void askSimple();
void askOrientation();
void analyzeResult(GcsQuestion question);
void evalSimple(GcsQuestion question);
void evalOrientation(GcsQuestion question);
Boolean checkAnswer(GcsQuestion question);
Boolean checkOrientation(GcsQuestion question);

// TODO: this should be session.state, if too complicated to be used alone,
// get another (complex) field in session that contains the phase 2 variables
String state;
// TODO: these should then go into the phase2 object in session, otherwise they
// will disappear between rule evaluations

Boolean second_try;
Boolean no_reaction;


/************************ START PHASE 2 ****************************************/

//Incoming: { "cmd": "test_conversation" }
// Outgoing { "status": "test_conversation", "arg0": "started" }

phase_two_start:
if (in_msg && in_msg.cmd == "test_conversation") {
  score_phase2 = 1;
  second_try = false;

  //Check general response?
  emitDA(#YNQuestion(checkResponse));
  state="wait";
  // wait for reaction
  start_speech_check();
  timeout("wait", 10000){
    state = "wait_reaction";
  }
}

if (!state) cancel;

/** Check for verbal reaction to initial Y/N question*/
phase_two_wait_reaction:
if (state == "wait_reaction"){
  // check reaction
  if (end_speech_check()==-1){ // no speech detected
    if (no_reaction){	// already second try --> send no_speech signal
      state = "no_speech";
      sendSignal("no_speech");
      removeLastCommand();
    } else {	// try again
      no_reaction = true;
      emitDA(#YNQuestion(checkResponse));
      state="wait";
      start_speech_check();
      timeout("wait", 10000){
        state = "wait_reaction";
      }
    }
  } else {  // if reaction: start questioning
    // Intro Phase 2
    emitDA(#Inform(Fragen));
    state = "ask_question";

    //Select simple question and pose it, send conversation message
    askSimple();
    sendSignal("test_conversation", "started");
    removeLastCommand();

    // check for answer
    start_speech_check();
    state="wait";
    timeout("wait", 10000){
      state = "wait_response";
    }
  }
}


// After question has been posed, _Analysis Phase_ starts
// *Analysis Phase

phase_two_wait_response:
if (state == "wait_response") {
  // check articulation
  int result = end_speech_check();
  if (result == -1) { // <-- { "status": "no_speech" }
    sendSignal("no_speech");
    state = "no_speech";
  } else { // <-- { "status": "speech_articulate", "arg0": "yes"/"no" }
    sendSignal("speech_articulate", (result == 1) ? "yes" : "no");
    state = "articulation_check";
  }
  removeLastCommand();

  // if articulated: check answer
  if (result == 1) {
    analyzeResult(currQuestion);
  }
}

/******************* METHODS **************************************/

/** ask simple question */
void askSimple(){
  currQuestion = getRandomItem("dom:SimpleQuestion");
  emitDA(#Question({currQuestion.questionLabel}));
}

/** ask orientation question */
void askOrientation(){
  currQuestion = getRandomItem("dom:OrientationQuestion");
  emitDA(#Question({currQuestion.questionLabel}));
}

/** Analyze result after question */
void analyzeResult(GcsQuestion question){
  if (!question.isOrientation){
    // evaluate simple question
    evalSimple(question);
  } else {
    // evaluate orientation question
    evalOrientation(question);
  }
}

/** Analyze answer to simple Question */
void evalSimple(GcsQuestion question){
  if (checkAnswer(question)) {
    /** simple question answered correctly --> try orientation question **/
    second_try = false; // TODO
    askOrientation();
    state="wait";
    timeout("wait", 10000){
      state = "wait_response";
    }
  } else {
    /** incorrect answer simple question **/
    // check if already second try
    if (second_try) {
      // already second try --> patient not able to answer questions
      //<-- { "status": "test_conversation", "arg0": "score_3" }
      sendSignal("test_conversation", "score_3");
      removeLastCommand();
      state = "gcs_phase3";
    } else {
      // first try: ask again
      second_try = true;
      askSimple();
      state="wait";
      timeout("wait", 10000){
        state = "wait_response";
      }
    }
  }
}


/** Analyze answer to orientation question */
void evalOrientation(GcsQuestion question){
  if (checkOrientation(question)) {
    /** both questions answered correctly, max Score **/
    // <-- { "status": "test_conversation", "arg0": "score_5" }
    sendSignal("test_conversation", "score_5");
    removeLastCommand();
    state = "gcs_phase3";
  } else {
    /** incorrect answer to orientation question **/
    if (second_try) { // already second try --> patient not oriented
      //<-- { "status": "test_conversation", "arg0": "score_4" }
      sendSignal("test_conversation", "score_4");
      removeLastCommand();
      state = "gcs_phase3";
    } else {
      // first try: ask again same difficulty
      second_try = true;
      askOrientation();
      state="wait";
      timeout("wait", 10000){
        state = "wait_response";
      }
    }
  }
}


/** check quality of answer to simple question */
Boolean checkAnswer(GcsQuestion question){
    // check if answer is in scope: get proposition and compare to lastDA
    String tmp = question.NERLabel;
    return (lastDA().getProposition() == tmp);
}


/** Test quality of answer to orientation question */
Boolean checkOrientation (GcsQuestion question){
  Calendar calendar = Calendar.getInstance();
  String answer = lastDA().what;
  String correct;
  switch(question.NERLabel){
  case "Weekday":
    correct = weekdays.get(calendar.get(Calendar.DAY_OF_WEEK) - 1);
    break;
  case "Month":
    correct = months.get(calendar.get(Calendar.MONTH));
    break;
  case "Year":
    correct = String.valueOf(calendar.get(Calendar.YEAR));
    break;
  default:
    // TODO
    answer = "unrecognized_answer";
    correct = "unrecognized_result";
    break;
  }
  // check if answer is correct
  return (answer == correct);
}
