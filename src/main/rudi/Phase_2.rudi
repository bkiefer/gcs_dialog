void generateQuestionList();
void startQuestions();
void checkAnswer(Quartet<DialogueAct, String, String, Boolean> question);
void checkOrientation (Quartet<DialogueAct, String, String, Boolean> question);
void calculateScore();

phase_two:
if (in_msg.get("cmd") == "check_mouth_movement"){
	// Check general respone 
    emitDA(#YNQuestion(checkResponse));
    // TODO wait answer?
    // TODO test if articulate speech
    if (lastDA() >= #Disagreement(NotParse)){           // check if answer cannot be interpreted
        // TODO score +2
      	out_signal.clear();
	    out_signal.put("status", "speech_analysed");
	    out_signal.put("articulate", "no");
	    getHub().sendSignal(out_signal); 
	}else{
	// TODO start verbal check
	emitDA(#Inform(Fragen));
	generateQuestionList();
	startQuestions();
	
	
	// abschlusssignal
    out_signal.clear();
    out_signal.put("status", "speech_analysed");
    out_signal.put("articulate", "yes");	    
    getHub().sendSignal(out_signal); 
	}

}


/*************************/
// TODO randomisiert erstellen oder durchlaufen?
void generateQuestionList() {
	// save questions as Quartet: (DA, intent, concept, bool (Orientierungsfrage ja/nein?))
    questions = new LinkedList<Quartet<DialogueAct, String, String, Boolean>>();        
    questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askName), "NAME", "Name", false));
    questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askAge), "AGE", "Age", false));        
    questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askBirthdate), "Date", "nuance_CALENDARX", false));
    questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askDay), "Date", "Weekday", true));
    questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askMonth), "Date", "Month", true));
	questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Question(askYear), "Date", "Year", true));
}


void startQuestions(){
	sum_phase2 = 0;         // sum of scores of all questions
    sum_orientiert = 0;     // number of correctly answered orientation questions        
    num_questions = questions.size();   // number of questions
    num_orientiert = 3; // number of orientation questions
    
    // Iterate through questions
    for (Quartet<DialogueAct, String, String, Boolean> one_question : questions){
    	emitDA(one_question.getFirst());
    	// TODO warte auf Signal
        state = "wait";
        timeout("wait", 20000){
        // TODO neuer if Block oder methode?
            state = "wait_answer";
            checkAnswer(one_question);
        }
    }
    // TODO calculate final score
    // calculateScore();
}


/** check quality of answer to question */
void checkAnswer(Quartet<DialogueAct, String, String, Boolean> question){
	// TODO if no mouth movement: exit?
	// TODO test articulation?
	// TODO yes no?
	if (!(getHub().readSignal().get("cmd") == "check_mouth_movement")){
		// TODO exit; send signal?
	}else{
		// check if answer is in scope: get proposition and compare to lastDA        
		String tmp = question.getSecond();
	    if (lastDA().getProposition() == tmp){
	    	sum_phase2 += 3;
	    	// check if orientation question; if yes: answer correct?
	        if (question.getFourth() == true){
	        	checkOrientation(question);
	        }
		}else{ // answer not in scope
			sum_phase2 += 2;
		}
	}
}

/** Test quality of answer to orientation question */
void checkOrientation (Quartet<DialogueAct, String, String, Boolean> question){
	Calendar calendar = Calendar.getInstance();
	String answer = lastDA().what;
	String correct;
	switch(question.getThird()){
	case "Weekday": 
        correct = weekdays.get(calendar.get(Calendar.DAY_OF_WEEK) - 1);
		break;
	case "Month": 
        correct = months.get(calendar.get(Calendar.MONTH));
		break;
	case "Year": 
        correct = String.valueOf(months.get(calendar.get(Calendar.YEAR)));
		break;
	default: 
	// TODO
		answer = "unrecognized_answer";
		correct = "unrecognized_result";
		break;
	}
	// if answer is correct, increase orientated score
	if (answer == correct){
       	sum_orientiert += 1;
    }
}

/** Calculate final score */
void calculateScore(){
	user.gcs_phase2 = sum_phase2 / num_questions; // TODO aufrunden oder ganzzahlig dividieren?
    // compute score for orientation questions
    if (sum_orientiert >= (num_orientiert/2)){   // wenn ca. Hälfte der Orientierungsfragen korrekt: +1 für orientiert
        user.gcs_phase2 += 1;
    }
    // TODO send score
}

