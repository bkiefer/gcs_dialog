/** GCS verbale Phase:
    konversationsfähig + orientiert: 5 Punkte
    konversationsfähig + desorientiert: 4 Punkte
    einzelne, unzusammenhängende Worte: 3 Punkte
    sinnlose Laute: 2 Punkte (können wir derzeit nicht unterscheiden von fehlendem Input)
    keine verbale Antwort: 1 Punkte
**/



void askSimple();
void askOrientation();
void analyzeResult(GcsQuestion question);
void evalSimple(GcsQuestion question);
void evalOrientation(GcsQuestion question);
Boolean checkOrientation(GcsQuestion question);

// TODO: this should be session.state, if too complicated to be used alone,
// get another (complex) field in session that contains the phase 2 variables
//String state;
// TODO: these should then go into the phase2 object in session, otherwise they
// will disappear between rule evaluations

/************************ START PHASE 2 ****************************************/

//Incoming: { "cmd": "test_conversation" }
// Outgoing { "status": "test_conversation", "arg0": "started" }

phase_two_start:
if (in_msg && in_msg.cmd == "test_conversation" && session.state == "greeted") {
  session.score_phase2 = 1;
  session.try_no = 1;
  sendSignal("test_conversation", "started");
  session.state = "phase2_started";
}

init_reaction:
if (session.state == "phase2_started") {
  // Check general response?
  emitDA(#YNQuestion(poseQuestion));
  session.state="phase2_wait_init_reaction";
  // wait for reaction from mouth movement/unarticulated speech sensor
  start_speech_check();
  timeout("wait_init_reaction", 10000) {
    session.state = "phase2_no_reaction";
    removeTimeout("wait_init_reaction");
  }
}

wait_init_reaction:
if (myLastDA() <= #YNQuestion(poseQuestion) && lastDA() <= #Confirm(top)) {
  // Check
  session.state = "phase2_first_question";
  cancelTimeout("wait_init_reaction");
}

no_reaction:
if (session.state == "phase2_no_reaction") { // timout hit for init reaction
  session.articulate = end_speech_check();
  if (session.articulate == -1) { // no speech detected
    sendSignal("no_speech");
    if (session.try_no < 2) {
      ++session.try_no;
      session.state = "phase2_started";
    } else { // second try, we give up, score 1
      session.state = "phase2_finished";
    }
  } else {
    session.state = "phase2_first_question";
  }
}

first_question:
if (session.state == "phase2_first_question") { // pose a question
  if (!waitingForResponse()) {
    session.question = "DayOfWeek"; // maybe generalise later
    emitDA(#Question({session.question}));
    start_speech_check();
    timeout("wait_for_answer", 20000) {
    question_retry:
      if (session.try_no < 2) {
        session.articulate = end_speech_check();
        ++session.try_no;
        //session.state = "phase2_first_question";
        emitDA(#Inform(Repeat, what=Question));
      } else {
        // give up
        session.articulate = end_speech_check();
        // No answer
        session.score_phase2 = 1;
        session.state = "phase2_finished";
      }
    }
  } else {
  answer_given:
    if (lastDA() <= #Answer(top) || lastDA() <= #Inform({session.question})) {
      if (checkAnswer(lastDA().what, session.question)) {
        session.articulate = 1;
        // Answer correct
        session.score_phase2 = (session.try_no == 1 ? 5 : 4);
        session.state = "phase2_finished";
      } else {
        emitDA(#Disconfirm(Answer, what={session.question}));
        ++session.try_no;
        session.state = "phase2_first_question";
      }
    }
  }
}



