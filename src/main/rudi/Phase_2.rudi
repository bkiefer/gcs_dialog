import java.util.Calendar;
import java.util.Random;

/**
TODOs
- save the result of questioning and "artikulierte sprache" into session object
**/

/** GCS verbale Phase:
    konversationsfähig + orientiert: 5 Punkte
    konversationsfähig + desorientiert: 4 Punkte
    einzelne, unzusammenhängende Worte: 3 Punkte
    sinnlose Laute: 2 Punkte (können wir derzeit nicht unterscheiden von fehlendem Input)
    keine verbale Antwort: 1 Punkte
**/

/******************* METHODS **************************************/



/********************** START PHASE 2 *************************************/

// Incoming: { "cmd": "test_conversation" }
// Outgoing { "status": "test_conversation", "arg0": "started" }

phase_two_start:
if (checkCmd("test_conversation") && session.state == "greeted") {
  session.score_phase2 = 1;
  session.try_no = 1;
  sendSignal("test_conversation", "started");
  session.state = "phase2_started";
  session.question = null;
}

init_reaction:
if (session.state == "phase2_started") {
  // Check general response?
  emitDA(#YNQuestion(poseQuestion, try={session.try_no}));
  session.state="phase2_wait_init_reaction";
  // wait for reaction from mouth movement/unarticulated speech sensor
  start_speech_check();
  if (session.try_no == 1) {
    timeout("wait_init_reaction", 10000) {
      ++session.try_no;
      removeTimeout("wait_init_reaction");
    }
  } else {
    // give up
    session.state = "phase2_finished";
  }
}

wait_init_reaction:
if (myLastDA() >= #YNQuestion(poseQuestion) && lastDA() >= #Confirm(top)) {
  // Check
  session.state = "phase2_question";
  cancelTimeout("wait_init_reaction");
  session.try_no = 0;
  lastDAprocessed();
}

no_reaction:
if (session.state == "phase2_no_reaction") { // timeout hit for init reaction
  session.articulate = end_speech_check();
  if (session.articulate == -1) { // no speech detected
    sendSignal("no_speech");
    if (session.try_no < 2) {
      ++session.try_no;
      session.state = "phase2_started";
    } else { // second try, we give up, score 1
      session.state = "phase2_finished";
    }
  } else {
    session.state = "phase2_question";
    session.try_no = 0;
    session.question_no = 1;
  }
}

answer_given:
if (session.question && lastDA() >= #Answer({session.question})) {
 check_answer:
  if (lastDA().what && checkAnswer(lastDA().what, session.question)) {
    session.articulate = 1;
    // Answer correct
    session.score_phase2 = (session.try_no == 1 ? 5 : 4);
    emitDA(#Confirm(Answer, what={session.question}));
    session.state = "phase2_finished";
  } else {
    emitDA(#Disconfirm(Answer, what={session.question}));
    session.state = "phase2_question";
  }
  lastDAprocessed();
}

pose_question:
if ((session.state == "phase2_question" && ! waitingForResponse())
    || session.state == "no_answer") {
 past_last_try:
  if (session.try_no == 2) {
    // give up
    session.articulate = end_speech_check();
    // No answer
    session.score_phase2 = 1;
    session.state = "phase2_finished";
    cancel;
  }

  // check if this is already try #2
  question_retry:
  if (session.try_no < 1) {
    ++session.try_no;
  } else {
    session.articulate = end_speech_check();
    ++session.try_no;
    emitDA(#Inform(Repeat, what=Question));
  }

  // pose a question
  session.question = "DayOfWeek"; // maybe generalise later
  emitDA(#Question({session.question}));
  start_speech_check();
  timeout("wait_for_answer", 20000) {
    session.state = "no_answer";
  }
}
