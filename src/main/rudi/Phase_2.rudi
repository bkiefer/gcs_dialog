import de.dfki.vondabase.utils.Triple;
import de.dfki.vondabase.utils.Quartet;
@*/


// TODO emitDA(#Inform(Fixpunkt)) nach checkResponse?
// TODO Punkteverteilung? Pro Frage Punkte auf Antworten + Qualität der Antwort?
//                        evtl: sub-score pro Frage/Topic und am Ende mitteln?
//                      wenn nur in Lauten antwortet: früher abbrechen?
// TODO Informationen speichern
/**
hasPain mit einem boolean Value
answersBirthday mit einem String Value
answersWeekday mit einem String Value
answersDate mit einem StringValue
**/

/** GCS verbale Phase: 
    konversationsfähig + orientiert: 5 Punkte
    konversationsfähig + desorientiert: 4 Punkte  
    einzelne, unzusammenhängende Worte: 3 Punkte
    sinnlose Laute: 2 Punkte
    keine verbale Antwort: 1 Punkte
**/

/** Ablauf Phase 2:
//TODO Informationen in user speichern (über intent/slot information wo speichern?)
tmp_score = 1
sum_orientiert = 0
num_orientiert = 0
if (patient nicht ansprechbar):         (max 2x?)
    state == phase 3
else:
    for question in [Name, Alter, Birthdate, Adresse, location, Wochentag, Datum....]:
        ask question: 
            if answer is not a word:     (antwortet nur in Lauten)
                tmp_score += 1
                continue
            if answer in scope:            (konversationsfähig,)
                tmp_score += 3
                if question in [location, Wochentag, Datum]:
                    if answer correct:
                        sum_orientiert += 1
                        num_orientiert += 1
            else:                       (antwortet in unzusammenhängenden Wörtern)
                tmp_score += 2
    user.gcs_phase2 = tmp_score / #questions (oder: max?)   (TODO runden, oder maximum nehmen)
    if sum_orientiert >= num_orientiert/2:   (wenn Hälfte der Orientierungsfragen korrekt --> orientiert)
        user.gcs_phase2 += 1
    ask pain:
        user.pain = answer
    state == phase 3
**/
/***************************************/

/**
// um Phase 3 zu testen
phase_two:
if(state == "gcs_phase2"){
    //user.gcs_phase2 = user.gcs_phase2 + 1;
    user.gcs_phase2 = 1;
    state = "gcs_phase3";
}
**/



phase_two_start:
if(state == "gcs_phase2"){
    user.gcs_phase2 = 1;
    no_reaction = false;
    emitDA(#YNquestion(checkResponse));
    state="wait";
    timeout("wait", 5000){
        state = "wait_response";
    }
}

phase_two_wait_response:
if(state == "wait_response"){
    // TODO bei fehlender Reaktion nochmal fragen? (Boolean um zu sehen ob schon mal in Schleife war)
    if (lastDA() >= #Bottom(Bottom)){       // wenn keine verbale Reaktion
        if (no_reaction == true){       // Patient hat bereits 1x nicht geantwortet
            state = "gcs_phase3";
        } else {        // wiederhole Ansprache
            no_reaction = true;
            emitDA(#YNquestion(checkResponse));
            state="wait";
            timeout("wait", 5000){
                state = "wait_response";
            }
        }
    } else {
        user.gcs_phase2 = user.gcs_phase2 + 1;
        // fülle Fragenliste
        // TODO erstelle randomisierte Liste (mind. Anzahl an Orientierungsfragen)?
        // speichere Fragen als Quartet: (DA, intent, concept, bool ob Orientierungsfrage)
        questions = new LinkedList<Quartet<DialogueAct, String, String, Boolean>>();
        // TODO NER intent etc
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Inform(askName), "TODO", "Name", false));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Inform(askAge), "AGE", "Age", false));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Inform(askBirthdate), "Date", "nuance_CALENDARX", false));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Inform(askAdress), "Location", "nuance_LOCATION", false));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Inform(askLocation), "Location", "nuance_LOCATION", true));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Inform(askDay), "Date", "Weekday", true));
        questions.add(new Quartet<DialogueAct, String, String, Boolean>(#Inform(askDate), "Date", "nuance_CALENDARX", true));

        sum_phase2 = 0;         // Summe ueber Scores aller Fragen
        sum_orientiert = 0;     // Anzahl korrekter Orientierungsfragen
        num_questions = questions.size();   // Anzahl Fragen
        num_orientiert = 3; // TODO Anzahl orientierungsfragen
        state = "wait";
        timeout("wait", 5000){
            state = "ask_question";     // start asking questions
        }
        // ??
        //lastDAprocessed() 
    }
}


phase_two_ask_question:
if(state == "ask_question"){
    // check if question list is empty --> wenn ja: weiter mit Phase 3
    if (questions.isEmpty() == true){
        // TODO Score mitteln
        user.gcs_phase2 = sum_phase2 / num_questions; // TODO aufrunden oder ganzzahlig dividieren?
        // TODO orientierungsscore ermitteln
        // if (sum_orientiert >= (num_orientiert/2)){   // wenn ca. Hälfte der Orientierungsfragen korrekt: +1 für orientiert
            // user.gcs_phase2 = user.gcs_phase2 + 1;
        // }
        //TODO nach Schmerzen fragen --> Score berechnung auslagern
        // weiter Phase 3
        state = "gcs_phase3";
    } else {    // ask first question in list
        emitDA(questions.get(0).first);
        state = "wait";
        timeout("wait", 5000){
            state = "wait_answer";  
        }
    }
}


phase_two_wait_answer:
if (state == "wait_answer"){
    // TODO Qualität der Antwort prüfen:
    if (!(lastDA() >= #Bottom(Bottom))){    // prüfe ob Patient antwortet
        // TODO: cerence auf Laute trainieren
        if (lastDA() >= #Disagreement(NotParse)){           // TODO Prüfe ob Antwort nur Laute sind
            sum_phase2 = sum_phase2 + 1;
        } else {
            // TODO prüfe ob Antwort in scope
            String tmp = questions.get(0).second;
            if (lastDA() >= #Answer(tmp)){
                sum_phase2 = sum_phase2 + 3;
                // TODO checke ob Orientierungsfrage, wenn ja: korrekt? --> summieren
                // if (questions.get(0).fourth == true){
                    // prüfe ob Antwort korrekt --> welche Frage ueber intent?
                    // wenn korrekt:
                    //      sum_orientiert = sum_orientiert +1;
                // }
            } else {
                sum_phase2 = sum_phase2 + 2;
            }
        }
    }
    // TODO: speicher information in user

    // entferne Frage aus liste
    questions.remove(0);
    state = "ask_question"; //ask next question
}
