/******************* METHODS **************************************/

/** ask simple question */
void askSimple(){
  currQuestion = getRandomItem("dom:SimpleQuestion");
  emitDA(#Question({currQuestion.questionLabel}));
}

/** ask orientation question */
void askOrientation(){
  currQuestion = getRandomItem("dom:OrientationQuestion");
  emitDA(#Question({currQuestion.questionLabel}));
}

/** Analyze result after question *
void analyzeResult(GcsQuestion question){
  if (!question.isOrientation){
    // evaluate simple question
    evalSimple(question);
  } else {
    // evaluate orientation question
    evalOrientation(question);
  }
  }*/

/** check quality of answer to simple question */
Boolean checkAnswer(GcsQuestion question){
    // check if answer is in scope: get proposition and compare to lastDA
    String tmp = question.NERLabel;
    return (lastDA().getProposition() == tmp);
}

boolean second_try;

/** Analyze answer to simple Question */
void evalSimple(GcsQuestion question){
  if (checkAnswer(question)) {
    /** simple question answered correctly --> try orientation question **/
    second_try = false; // TODO
    askOrientation();
    session.state="wait";
    timeout("wait", 10000){
      session.state = "wait_response";
    }
  } else {
    /** incorrect answer simple question **/
    // check if already second try
    if (second_try) {
      // already second try --> patient not able to answer questions
      //<-- { "status": "test_conversation", "arg0": "score_3" }
      sendSignal("test_conversation", "score_3");
      removeLastCommand();
      session.state = "gcs_phase3";
    } else {
      // first try: ask again
      second_try = true;
      askSimple();
      session.state="wait";
      timeout("wait", 10000){
        session.state = "wait_response";
      }
    }
  }
}


/** Analyze answer to orientation question *
void evalOrientation(GcsQuestion question){
  if (checkOrientation(question)) {
    /** both questions answered correctly, max Score **
    // <-- { "status": "test_conversation", "arg0": "score_5" }
    sendSignal("test_conversation", "score_5");
    removeLastCommand();
    session.state = "gcs_phase3";
  } else {
    /** incorrect answer to orientation question **
    if (second_try) { // already second try --> patient not oriented
      //<-- { "status": "test_conversation", "arg0": "score_4" }
      sendSignal("test_conversation", "score_4");
      removeLastCommand();
      session.state = "gcs_phase3";
    } else {
      // first try: ask again same difficulty
      second_try = true;
      askOrientation();
      session.state="wait";
      timeout("wait", 10000){
        session.state = "wait_response";
      }
    }
  }
}




