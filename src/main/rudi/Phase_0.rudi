/** GCS start */
//incoming: { "cmd": "start_gcs" }
//outgoing: { "status": "ready" }

gcs_ready:
if (in_msg.cmd == "start_gcs"){
    System.err.println("GCS service started");
    out_signal.clear();
    out_signal.put("status", "ready");
    getHub().sendSignal(out_signal);
    //state = "gcs_start";
    newData();
}
