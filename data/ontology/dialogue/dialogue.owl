<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.dfki.de/lt/onto/common/dialogue.owl#"
     xml:base="http://www.dfki.de/lt/onto/common/dialogue.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:xsp="http://www.owl-ontologies.com/2005/08/07/xsp.owl#"
     xmlns:dial="http://www.dfki.de/lt/onto/common/dialogue.owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:protege="http://protege.stanford.edu/plugins/owl/protege#">
    <owl:Ontology rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">author(s): Hans-Ulrich Krieger, Stefania Racioppa</rdfs:comment>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">v0.9.6</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#measure -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#measure"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#monetary -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#monetary"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#addressee -->

    <owl:ObjectProperty rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#addressee">
        <rdfs:domain rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:range rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Agent"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the addressee(s) of the dialogue act; in case several actors need to be specified, we usually &quot;bundle&quot; them in a container (group) object whose definition should come from an upper or domain ontology;
sometimes called &apos;speaker&apos;; not used at the moment !!</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#follows -->

    <owl:ObjectProperty rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#follows">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:range rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">follows links the current dialogue act with its _immediate_ predecessors (a transitive property)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#frame -->

    <owl:ObjectProperty rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#frame">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the frame which encodes the (shallow) semantics/the semantic content of
    the dialogue act; in principle, this property should be part of a
    domain-specific ontology which interfaces dialogue acts and FrameNet
    frames through the property frame, by defining a domain (viz.,
    dial:DialogueAct) and a range (viz., sem:Frame) restriction</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#participant -->

    <owl:ObjectProperty rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#participant">
        <rdfs:domain rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:range rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Agent"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">further participants (besides &apos;sender&apos; and &apos;addressee&apos;), being typed to Agent to even address groups;
called &apos;side-participants&apos;, &apos;bystanders&apos;, and &apos;overhearers&apos; by Clark (1996)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#refersTo -->

    <owl:ObjectProperty rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#refersTo">
        <rdfs:domain rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:range rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">refersTo implements a kind of &apos;indirect speech&apos; when used with DAs DeclineXXX, RejectXXX, and RevokeXXX: these are dialogue acts on which the _current_ DA depends on; DIT++ sometimes call those former DAs a &apos;antecedent&apos; DA</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#sender -->

    <owl:ObjectProperty rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#sender">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:range rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Agent"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the sender who initiates the dialogue act and who wants to influence the addressee; sometimes called &apos;hearer&apos; or &apos;recipient&apos;</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#happens -->

    <owl:DatatypeProperty rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#happens">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#long"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">happens is employed to encode a time stamp, thus able to establish a partial order over DAs; through the happens property, we are able to assign several DAs to the _same_ utterance</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#repr -->

    <owl:DatatypeProperty rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#repr">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A string representation of the dialogue act</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Accept -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Accept">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AggregateFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AcceptOffer -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AcceptOffer">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Accept"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AddressOffer"/>
        <owl:disjointWith rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DeclineOffer"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AcceptRequest -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AcceptRequest">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Accept"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AddressRequest"/>
        <owl:disjointWith rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DeclineRequest"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act by which the sender, S, commits himself to perform an action that he has been requested to perform, possibly depending on certain conditions that he makes explicit.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AcceptSuggestion -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AcceptSuggestion">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Accept"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AddressSuggestion"/>
        <owl:disjointWith rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DeclineSuggestion"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act by which the sender, S, commits himself to perform an action that was suggested to him, possibly with certain restrictions or conditions concerning manner or frequency of performance.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#ActionDiscussionFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#ActionDiscussionFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#InformationTransferFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AddressOffer -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AddressOffer">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Instruct"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AddressRequest -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AddressRequest">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Commissive"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act by which the sender, S,
indicates that he considers the performance of an action that he was requested to perform.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AddressSuggestion -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AddressSuggestion">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Commissive"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act by which the sender, S,
indicates that he considers to perform an action that was suggested to him, possibly depending on certain conditions that he makes explicit.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Advice -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Advice">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Directive"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      a suggestion, not part of DIT++
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Agent -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Agent"/>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AggregateFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AggregateFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      this subclass of DialogueAct is intended to cross-classify dialogue acts
      which are subclasses of GeneralPurposeFunction; the idea behind this is
      to address uncertainty in the recognition of &amp;quot;related&amp;quot; dialogue acts
      through a _single_ class;
    &lt;/p&gt;
    &lt;p style=&quot;margin-top: 0&quot;&gt;
      currently, we suggest to have three subclasses of AggregateFunction for
      which I list their subclasses below:
    &lt;/p&gt;
    &lt;p style=&quot;margin-top: 0&quot;&gt;
      * Accept &amp;gt;
      {AcceptOffer,AcceptSuggestion,AcceptRequest,Confirm,CheckPositive,Agreement}
    &lt;/p&gt;
    &lt;p style=&quot;margin-top: 0&quot;&gt;
      * Decline &amp;gt;
      {DeclineOffer,DeclineSuggestion,DeclineRequest,Disconfirm,CheckNegative,Disagreement}
    &lt;/p&gt;
    &lt;p style=&quot;margin-top: 0&quot;&gt;
      * Revoke &amp;gt; {Revocation,Correction,RevokeSuggestion}
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Agreement -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Agreement">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Accept"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Inform"/>
        <owl:disjointWith rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Disagreement"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act performed by the sender, S, in order to inform the addressee, A that S assumes a given proposition to be true, which S believes that A also assumes to be true.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AlloFeedback -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AlloFeedback">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#FeedbackFunction"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      Allo-Feedback acts are about the speaker&apos;s beliefs about the addressee&apos;s
      attention and processing of an utterance in the speaker&apos;s last turn (see
      http://dit.uvt.nl/#dit_allo-fb-functions)
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AlloNegative -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AlloNegative">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#FeedbackGivingFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AlloPositive -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AlloPositive">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#FeedbackGivingFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Answer -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Answer">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Inform"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act performed by the sender, S, in order to make certain information available to the addressee, A, which S believes A wants to know; S assumes that this information is correct.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Apologizing -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Apologizing">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#SocialObligationManagementFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Apology -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Apology">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Apologizing"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#ApologyDownplay -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#ApologyDownplay">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Apologizing"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Appeasement -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Appeasement">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#SocialFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AutoFeedbackFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AutoFeedbackFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#FeedbackFunction"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      Auto-Feedback acts are about the speaker&apos;s own attention and processing
      of an utterance in the addressee&apos;s last turn (see
      http://dit.uvt.nl/#dit_auto-fb-functions)
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AutoNegative -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AutoNegative">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AutoFeedbackFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#AutoPositive -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#AutoPositive">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AutoFeedbackFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Breaking -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Breaking">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#TimeManagementFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#CheckNegative -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#CheckNegative">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#CheckQuestion"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Decline"/>
        <owl:disjointWith rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#CheckPositive"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#CheckPositive -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#CheckPositive">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Accept"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#CheckQuestion"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#CheckQuestion -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#CheckQuestion">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#YNQuestion"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act performed by the sender, S,
in order to know whether a proposition, which forms the semantic content, is true, S holds the uncertain belief that it is true S. 
S assumes that A knows whether the proposition is true or not, and puts pressure on A to provide this information.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#ChoiceQuestion -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#ChoiceQuestion">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Question"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act performed by the sender, S,
in order to know which one from a list of alternative propositions, specified by the semantic content, is true; S believes that exactly one element of that list is true; 
S assumes that the addressee, A, knows which of the alternative propositions is true, and S puts pressure on A to provide this information.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Commissive -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Commissive">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#ActionDiscussionFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Confirm -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Confirm">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Accept"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Answer"/>
        <owl:disjointWith rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Disconfirm"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act performed by the sender, S, in order to inform the addressee, A, that certain information that A wants to know, and concerning which A holds an uncertain belief, is indeed correct.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Confirming -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Confirming">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Connecting"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Congratulation -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Congratulation">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#SocialFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Connecting -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Connecting">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#SocialFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Correction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Correction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Disagreement"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Revoke"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act performed by the sender, S, in order to inform the addressee, A, that certain information which S has reason to believe that A assumes to be correct, is in fact incorrect and that instead the information that S provides is correct.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Decline -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Decline">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AggregateFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#DeclineOffer -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#DeclineOffer">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AddressOffer"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Decline"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#DeclineRequest -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#DeclineRequest">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AddressRequest"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Decline"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act by which the sender, S,
indicates that he refuses to perform an action that he has been requested to perform, possibly depending on certain conditions that he makes explicit.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#DeclineSuggestion -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#DeclineSuggestion">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AddressSuggestion"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Decline"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act by which the sender, S, indi-
cates that he will not perform an action that was suggested to him, possibly depending on certain conditions that he makes explicit.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a large part of the DIT++ taxonomy for dialogue acts</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueControlFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueControlFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DimensionSpecificFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#DimensionSpecificFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#DimensionSpecificFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Directive -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Directive">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#ActionDiscussionFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Disagreement -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Disagreement">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Decline"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Inform"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act performed by the sender, S, in order to inform the addressee, A that S assumes a given proposition to be false, which S believes that A assumes to be true.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Disconfirm -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Disconfirm">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Answer"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Revoke"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act performed by the sender, S, in order to let the addressee, A, know that certain information that A wants to know, and concerning which A holds an uncertain belief, is incorrect.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#DomainRelatedFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#DomainRelatedFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueControlFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Encouragement -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Encouragement">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Directive"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      a suggestion, not part of DIT++
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#FeedbackFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#FeedbackFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueControlFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#FeedbackGivingFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#FeedbackGivingFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AlloFeedback"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#GeneralPurposeFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#GeneralPurposeFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueAct"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">note: as the taxonomy for general purpose functions have slightly
changed over the course of the papers, I have sticked to description
found in the appendix entitled &quot;The DIT++ taxonomy of communicative
functions&quot;, found in &apos;The semantics of dialogue acts&apos; (Proceedings of the
9th International Conference on Computational Semantics (IWCS-9), pp.
1-13, 2011).
note: through the use of property &apos;id&apos;, we are able to assign multiple
dialogue acts to the same utterance (called &apos;multidimensional dialogue
act annotation&apos;)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#GratitudeExpression -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#GratitudeExpression">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#SocialObligationManagementFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#IndirectRequest -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#IndirectRequest">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Directive"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Inform -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Inform">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#InformationProvidingFunction"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act performed by the sender, S, in order to make the information contained in the semantic content known to the addressee, A; 
S assumes that the information is correct.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#InformAction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#InformAction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Inform"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#InformFact -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#InformFact">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Inform"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#InformationProvidingFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#InformationProvidingFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#InformationSeekingFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#InformationSeekingFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#InformationSeekingFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#InformationTransferFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#InformationTransferFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#InformationTransferFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#GeneralPurposeFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#InitialGoodbye -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#InitialGoodbye">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Valediction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#InitialGreeting -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#InitialGreeting">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Salutation"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#InitialSelfIntroduction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#InitialSelfIntroduction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#SelfIntroduction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Instruct -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Instruct">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Directive"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#InteractionManagementFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#InteractionManagementFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueControlFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Offer -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Offer">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Commissive"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act by which the sender, S, indicates his willingness and ability to perform the action, specified by the semantic content, conditional on the consent of addressee A that S do so.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Pausing -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Pausing">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#TimeManagementFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Permission -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Permission">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Directive"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Praise -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Praise">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#SocialFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Promise -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Promise">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Offer"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act by which the sender, S, commits himself to perform the action, specified in the semantic content, in the manner or with the frequency or depending on the conditions that he makes explicit. S believes that this action would be in A’s interest.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Proposal -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Proposal">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Directive"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      a suggestion, not part of DIT++
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Question -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Question">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#InformationSeekingFunction"/>
        <rdfs:comment xml:lang="en">Communicative function of a dialogue act performed by the sender, S, in order to obtain the information specified by the semantic content; S assumes that the addressee, A, possesses this information; S puts pressure on A to provide this information.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Request -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Request">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#IndirectRequest"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#ReturnGoodbye -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#ReturnGoodbye">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Valediction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#ReturnGreeting -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#ReturnGreeting">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Salutation"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#ReturnSelfIntroduction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#ReturnSelfIntroduction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#SelfIntroduction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Revocation -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Revocation">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueControlFunction"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Directive"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">originally not part of DIT++, but DIT++ is open in that direction as they say &quot;Other commissives, as expressible by means of performative verbs or by addressing other directives&quot;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Revoke -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Revoke">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AggregateFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#RevokeSuggestion -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#RevokeSuggestion">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#AddressSuggestion"/>
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Revoke"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">originally not part of DIT++, but DIT++ is open in that direction as they say &quot;Other commissives, as expressible by means of performative verbs or by addressing other directives&quot;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Salutation -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Salutation">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#SocialObligationManagementFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#SelfIntroduction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#SelfIntroduction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#SocialObligationManagementFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#SocialFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#SocialFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DomainRelatedFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#SocialObligationManagementFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#SocialObligationManagementFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#DialogueControlFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Stalling -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Stalling">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#TimeManagementFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Suggestion -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Suggestion">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#Directive"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#Thanking -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#Thanking">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#GratitudeExpression"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#ThankingDownplay -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#ThankingDownplay">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#GratitudeExpression"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#TimeManagementFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#TimeManagementFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#InteractionManagementFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#TurnAccept -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnAccept">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnUnitInitialFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#TurnAssign -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnAssign">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnUnitFinalFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#TurnGrab -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnGrab">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnUnitInitialFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#TurnKeep -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnKeep">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnUnitFinalFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#TurnManagementFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnManagementFunction">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#InteractionManagementFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#TurnRelease -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnRelease">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnUnitFinalFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#TurnTake -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnTake">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnUnitInitialFunction"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/common/dialogue.owl#TurnUnitFinalFunction -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/common/dialogue.owl#TurnUnitFinalFunction">
