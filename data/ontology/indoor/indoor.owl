        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/intuitiv/indoor#Connector"/>
        <rdfs:comment>Examples: An exterior stairway has the affordance of OIConnector.</rdfs:comment>
    </owl:Class>



    <!-- http://www.dfki.de/lt/onto/intuitiv/indoor#OIPortal -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/indoor#OIPortal">
