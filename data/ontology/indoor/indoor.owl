        <rdfs:comment>Examples: Exterior doorway and window have the affordance of OIPortal.</rdfs:comment>
    </owl:Class>



    <!-- http://www.dfki.de/lt/onto/intuitiv/indoor#Obstacle -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/indoor#Obstacle">
        <rdfs:comment>Examples: Road construction has the affordance of obstacle.</rdfs:comment>
    </owl:Class>



    <!-- http://www.dfki.de/lt/onto/intuitiv/indoor#Passage -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/indoor#Passage">
