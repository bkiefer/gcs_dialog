        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      a &amp;quot;free-text&amp;quot; field which can be filled with anything and from which
      potential useful information can be extracted
    &lt;/p&gt;</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.dfki.de/lt/onto/intuitiv/domain.owl#source">
