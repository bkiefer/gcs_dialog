    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/intuitiv/domain.owl#IntuitivDomain -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/domain.owl#IntuitivDomain">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      the most general class which covers the concepts of the Intuitiv domain
      without any particular epistemological backround; used to define a
      &amp;quot;naming&amp;quot; property dom:name and a general &amp;quot;free-text&amp;quot; property dom:remark
      from which potential useful information can be extracted through
      external processes
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/intuitiv/domain.owl#Language -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Language">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/intuitiv/domain.owl#IntuitivDomain"/>
        <rdfs:comment xml:lang="en">the language of an actor</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/intuitiv/domain.owl#Location -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Location">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/intuitiv/domain.owl#IntuitivDomain"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/intuitiv/domain.owl#Male -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Male">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Gender"/>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/intuitiv/domain.owl#Mood -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Mood">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/intuitiv/domain.owl#IntuitivDomain"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      various kinds of mood are represented as instances at the moment; is
      there a widely accepted specialization hierarchy out there? if so, we
      would then translate it into a subclass hierarchy!
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/intuitiv/domain.owl#Patient -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Patient">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Animate"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      note: the properties defined on class dom:Child can in principle be
      relocated to the superclass dom:Actor, but I think it is not interesting
      to know, say, who the father or brother of a treating physician is here
      in PAL :*); and of course to make a distinction between animated and
      inanimated actors, as the properties probably only make sense for
      animated actors
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


