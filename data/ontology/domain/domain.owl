    <!-- http://www.dfki.de/lt/onto/intuitiv/domain.owl#Disease -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Disease">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/intuitiv/domain.owl#IntuitivDomain"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      note: starting and ending time of a dom:Disease as well as a
      dom:Treatment is not specified here (and would need to reduplicate the
      two properties in two different classes), but instead is given through
      the axioms as a side effect, when interfacing this domain ontology with
      the upper ontology, by making dom:Disease and dom:Treatment subclasses
      of upp:Happening
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


