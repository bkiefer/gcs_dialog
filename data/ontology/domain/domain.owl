    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.dfki.de/lt/onto/intuitiv/domain.owl#Activity -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Activity">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;p style=&quot;margin-top: 0&quot;&gt;
      dom:Activity both subsumes playing a dom:Game and creating a dom:Medium;
    &lt;/p&gt;
    &lt;p style=&quot;margin-top: 0&quot;&gt;
      dom:Activity might involve other participant, but this is addressed in
      the upp:Happening class of the upper ontology
    &lt;/p&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/intuitiv/domain.owl#Actor -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Actor">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/intuitiv/domain.owl#IntuitivDomain"/>
        <rdfs:comment xml:lang="en">(prefferd) language of an actor, used for e.g. interface</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.dfki.de/lt/onto/intuitiv/domain.owl#Animate -->

    <owl:Class rdf:about="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Animate">
        <rdfs:subClassOf rdf:resource="http://www.dfki.de/lt/onto/intuitiv/domain.owl#Actor"/>
    </owl:Class>
    


